{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ibex",
  "scopeName": "source.ibex",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#literals" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#attributes" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.ibex"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.ibex",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.ibex"
            }
          ]
        },
        {
          "begin": "`",
          "end": "`",
          "name": "string.quoted.raw.ibex"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(struct|enum|flag|using|return|if|else|is|for|in|while|break|continue|static|const|var|as|package|export|module|import|typeof|sizeof|or|ref|switch|case|move|default)\\b",
          "name": "keyword.control.ibex"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|byte|f32|f64|bool|text|void)\\b",
          "name": "support.type.primitive.ibex"
        },
        {
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
          "name": "entity.name.type.ibex"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "match": "\\b(true|false|null)\\b",
          "name": "constant.language.ibex"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0x[0-9a-fA-F]+\\b",
          "name": "constant.numeric.hex.ibex"
        },
        {
          "match": "\\b0b[01]+\\b",
          "name": "constant.numeric.binary.ibex"
        },
        {
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?([a-zA-Z0-9_]+)?\\b",
          "name": "constant.numeric.decimal.ibex"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(\\+|-|\\*|/|%|==|!=|<|>|<=|>=|=|:=|\\+=|-=|\\*=|/=|&|\\||\\^|~|&&|\\|\\||!|<<|>>|\\.|->|::|\\?)",
          "name": "keyword.operator.ibex"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=:)",
          "name": "entity.name.function.ibex"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.ibex"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "match": "\\[\\[([^\\]]+)\\]\\]",
          "name": "storage.modifier.attribute.ibex"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b",
          "name": "variable.other.ibex"
        }
      ]
    }
  }
}

