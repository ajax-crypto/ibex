// Test: Inline/lambda functions — immediately invoked function expressions
package lambda_tests {
    test_iife: () -> void {
        // Basic IIFE: inline function called immediately
        x := ((y: i32) -> i32 { return y + 1; })(3);

        // Multi-param lambda
        sum := ((a: i32, b: i32) -> i32 { return a + b; })(10, 20);

        // Void lambda (no return type)
        ((msg: text) { return; })("hello");

        // Zero-param lambda
        val := (() -> i32 { return 42; })();

        // Nested: lambda returning result of another expression
        doubled := ((n: i32) -> i32 { return n * 2; })(5);
    }

    test_lambda_as_value: () -> void {
        // Lambda assigned to variable (not immediately invoked)
        inc := (x: i32) -> i32 { return x + 1; };
        result := inc(10);

        // Lambda with no return type (void)
        printer := (msg: text) { return; };
        printer("hello");
    }
}
