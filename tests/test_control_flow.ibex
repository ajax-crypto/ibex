// Control-flow and compile-time expression coverage.
package control_flow_tests {
    const MAX_ITEMS: i32 = 2 + 3 * 4;
    const MASK: i32 = (1 << 3) | 2;
    const ENABLED: bool = true && !false;

    // Branch selection, including an else-if chain and a constant condition.
    classify: (value: i32) -> i32 {
        if value < 0 {
            return -1;
        } else if value == 0 {
            return 0;
        } else if value < 10 {
            return 1;
        } else {
            return 2;
        }
    }

    constant_branch: () -> i32 {
        if ENABLED && (MAX_ITEMS == 14) {
            return MASK;
        } else {
            return 0;
        }
    }
    
    nested_if_tests: (a: i32, b: i32) -> i32 {
        res := 0;
        if a > 0 {
            if b > 0 {
                res = 1;
            } else if b == 0 {
                res = 2;
            } else {
                res = 3;
            }
        } else if a == 0 {
            if b > 0 {
                res = 4;
            } else {
                res = 5;
            }
        } else {
            if b < 0 {
                if a < -10 {
                    res = 6;
                } else {
                    res = 7;
                }
            } else {
                res = 8;
            }
        }
        return res;
    }

    // A while loop with continue, break, and an else branch.
    while_break_continue: (limit: i32) -> i32 {
        var index: i32 = 0;
        var total: i32 = 0;
        while index < limit {
            index += 1;
            if index == 2 {
                continue;
            }
            if index > 8 {
                break;
            }
            total += index;
        } else {
            total += 100;
        }
        return total;
    }

    // A for loop over a value and its empty-range corner case.
    for_break_continue: (count: i32) -> i32 {
        var total: i32 = 0;
        for item in 0..count {
            if item == 0 {
                continue;
            }
            if item > 8 {
                break;
            }
            total += item;
        } else {
            total += 1000;
        }
        return total;
    }

    empty_for: () -> void {
        for item in [] {
            continue;
        } else {
            return;
        }
    }

    // Nested loops and branches exercise scope boundaries for loop variables.
    nested_control_flow: () -> i32 {
        var outer: i32 = 0;
        var total: i32 = 0;
        while outer < 3 {
            var inner: i32 = 0;
            for item in 0..outer {
                if item == inner {
                    total += item;
                } else {
                    total += 1;
                }
                inner += 1;
            }
            outer += 1;
        }
        return total;
    }

    // Constant expressions can feed declarations, array sizes, and conditions.
    constant_expression_shapes: () -> void {
        const local_limit: i32 = MAX_ITEMS - 4;
        const local_mask: i32 = MASK ^ 1;
        const local_enabled: bool = ENABLED || false;
        values: [14]i32;
        if local_enabled && local_limit > 0 {
            values[0] = local_mask;
        }
    }

    // Const modifiers and blocks are valid around control-flow scopes.
    const_control_scope: () -> void {
        value := 10;
        const (value) {
            if value == 10 {
                return;
            }
        }
    }

    test_switch_case: () -> void {
        x := 2;
        res := 0;
        switch (x) {
            case 1: res = 10;
            case 2: res = 20;
            default: res = 30;
        }
        
        y := 5;
        res2 := 0;
        switch (y) {
            case 1..3: res2 = 1;
            case 4..6 {
                res2 = 2;
            }
            default: res2 = 3;
        }
        
        // String-based switch
        cmd := "start";
        str_res := 0;
        switch (cmd) {
            case "start": str_res = 1;
            case "stop": str_res = 2;
            case "pause": str_res = 3;
            default: str_res = 4;
        }
    }
    
    
    
    enum Status { OK, Error, Unknown }

    range_in_test: () -> void {
        x := 2;
        if x in 0..3 {
            res := 1;
        }
        // Flag range test
        f := Status.OK;
        if f in Status.OK..Status.Unknown {
            res := 2;
        }
    }

    test_c_style_for_loop: () -> void {
        arr := [1, 2, 3];
        for (i := 0; i < 3; i = i + 1) {
            x := arr[i];
        }
    }

    test_range_style_for_loop: () -> void {
        arr := [1, 2, 3];
        for elem in arr {
            y := elem;
        }
        for elem:idx in arr {
            z := elem;
        }
        for elem:idx in ~arr {
            w := elem;
        }
    }

    test_range_expr_for_loop: () -> void {
        for i in 1..10 {
            x := i;
        }
        for i:idx in 1..10 {
            y := i;
        }
        for i in ~1..10 {
            z := i;
        }
    }
    test_valid_loops: () -> void {
        x := 0;
        while (x < 10) {
            x = x + 1;
        }
        
        while (x < 20) {
            x += 1;
        }
        
        y := 0;
        for (i := 0; i < 10; i = i + 1) {
            y = y + 1;
        }
    }
    
    // Global variable
    GLOBAL_VAR : i32 = 0;
    
    test_complex_loops: () -> void {
        // Global variables skip detection
        while (GLOBAL_VAR < 10) {
            y := 1;
        }
        
        // Pass by reference is considered mutation
        x := 0;
        while (x < 10) {
            mutate(ref x);
        }
        
        y := 0;
        while (y < 10) {
            mutate_ptr(@y);
        }
    }
}

mutate: (val: &i32) -> void {}
mutate_ptr: (val: *i32) -> void {}





