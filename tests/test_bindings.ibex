// Test: Function binding and void return omission
package binding_tests {
    // Full function with -> void
    greet: (name: text, greeting: text) -> void {
        return;
    }

    // Function without -> void (equivalent to -> void)
    log_message: (msg: text) {
        return;
    }

    // A function with multiple params for binding tests
    add: (x: i32, y: i32) -> i32 {
        return x + y;
    }

    // Another function with 3 params
    clamp: (val: i32, lo: i32, hi: i32) -> i32 {
        if val < lo { return lo; }
        if val > hi { return hi; }
        return val;
    }

    test_bindings: () {
        // Bind y=10 to add, creating a new function that takes only x
        add10 := #add(y=10);
        result := add10(5);  // equivalent to add(5, 10) = 15

        // Bind lo and hi, creating a function that takes only val
        clamp_byte := #clamp(lo=0, hi=255);
        clamped := clamp_byte(300);  // equivalent to clamp(300, 0, 255) = 255

        // Bind greeting
        hello := #greet(greeting="Hello");
        hello("World");  // equivalent to greet("World", "Hello")

        // Bind single param
        add5 := #add(y=5);
        r2 := add5(3);   // equivalent to add(3, 5) = 8
    }

    // Test: void return type omission — these should all be equivalent
    void_explicit: () -> void {
        return;
    }

    void_omitted: () {
        return;
    }

    no_return_stmt: () {
        // no return needed for void functions
    }
}
