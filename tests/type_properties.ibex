// Test: Type property errors — accessing float properties on int types
package type_prop_errors {
    test_invalid_props: () -> void {
        // These should produce errors
        bad1 := i32.infinity;       // .infinity only on f32/f64
        bad2 := u8.nan;             // .nan only on f32/f64
        bad3 := i64.epsilon;        // .epsilon only on f32/f64
        bad4 := u32.signaling_nan;  // .signaling_nan only on f32/f64
    }
}
