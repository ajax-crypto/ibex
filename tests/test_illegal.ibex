// Negative tests. This file must fail lexing, parsing, or semantic analysis.
package illegal_tests {
    // Integer literals outside their declared ranges.
    overflow_literals: () -> void {
        too_large_u8: u8 = 256u8;
        too_large_i8: i8 = 128i8;
        too_small_i8: i8 = -129i8;
        too_large_u16: u16 = 65536u16;
        too_large_u32: u32 = 4294967296u32;
        negative_unsigned: u64 = -1u64;
    }

    // Floating-point properties are not available on integer types.
    invalid_integer_properties: () -> void {
        bad_infinity := i32.infinity;
        bad_nan := u8.nan;
        bad_epsilon := i64.epsilon;
        bad_signaling_nan := u32.signaling_nan;
    }

    // A local variable cannot be referenced after its scope ends.
    invalid_lifetime: () -> void {
        {
            scoped_value := 10;
        }
        escaped_value := scoped_value;
    }

    // Unknown names and incompatible declared types are invalid.
    invalid_names_and_types: () -> void {
        missing_value := does_not_exist;
        wrong_type: i32 = true;
    }

    // Invalid tuple access and non-constant indices
    invalid_tuple_access: () -> void {
        tup : (i32, f64) = (1, 2.0);
        out_of_bounds := tup[2];
        
        dynamic_idx := 1;
        non_const_access := tup[dynamic_idx];

        invalid_prop := tup.length;
    }

    // Function with non-trailing optional parameter
    func_with_bad_opts : (x: i32?, y: i32) -> void {
    }

    invalid_optional_call: () -> void {
        func_with_bad_opts(2); // Illegal: y is not optional and not specified
    }

    // Invalid variant usages
    invalid_variants: () -> void {
        uninit_var : (i32 + f64); // Error: uninitialized variant
        
        v : (i32 + f64) = 5;
        bad_mem := v.length; // Error: variants only have 'which' and 'count'
        
        // Ambiguous variant
        ambig_var : (i32 + i64) = 5; // Error: ambiguous variant initialization
    }

    // Invalid array usages
    invalid_arrays: () -> void {
        x : [8]i32 = [1, 2, 3, 4, 5, 6, 7, 8];
        
        // Out of bounds array index
        bad_idx := x[10]; // Error: array index out of bounds
    }

    // Invalid bitwise usages
    invalid_bitwise: () -> void {
        f : f32 = 1.0;
        
        bad_or := f | 2.0; // Error: bitwise ops only on int
        bad_comp := ~f;    // Error: bitwise complement only on int
    }

    flag BadFlag : u32 {
        A, B
    }

    invalid_flags: () -> void {
        x : BadFlag = BadFlag.A;
        
        // Arithmetic on flags is illegal
        bad_add := x + BadFlag.B;
        
        // Non-existent member
        bad_mem := x.non_existent;
        
        // Non-existent enum member
        bad_enum := BadFlag.C;
        
        // Bad methods
        x.set(); // Error: expected 1 arg
        x.has(1, 2); // Error: expected 1 arg
    }
}
